# Docker Compose and infrastructure configuration.
# Copy this file to .env. Backend application settings go in backend/.env.
# Do not add DB_HOST, REDIS_HOST, or DATABASE_URL here.

COMPOSE_PROJECT_NAME=quantmind
TZ=Asia/Shanghai

# 浏览器版 Web 容器映射到宿主机的端口。Compose 不读取 backend/.env
# 进行端口插值，故此项必须留在根 .env。
WEB_HOST_PORT=3080

# PostgreSQL container and backend connection credentials.
POSTGRES_DB=quantmind
POSTGRES_USER=quantmind
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Redis container and backend connection credentials.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# RSSHub 默认由 docker-compose 使用上面的 REDIS_PASSWORD 连接 Redis DB 3。
# 仅当密码含 @、:、/、?、#、% 等 URI 保留字符时，填写包含 URL 编码密码的完整 URL。
# RSSHUB_REDIS_URL=redis://:URL_ENCODED_REDIS_PASSWORD@redis:6379/3

# Docker build / host integration.
TORCH_DEVICE=cpu
# 可选：默认使用官方 CPU wheel 索引。仅在内部镜像已同步 torch 2.9.1+cpu 时覆盖。
# TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
