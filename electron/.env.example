# QuantMind OSS 环境变量配置示例
# 复制此文件为 .env 并根据需要修改

# OSS 部署使用相对路径，通过 Nginx/反向代理访问后端
# 前端会自动使用当前域名作为 API 基地址
# VITE_API_BASE_URL=
# VITE_USER_API_URL=
# VITE_WS_BASE_URL=

# 开发环境配置示例（Vite 同源代理，支持局域网浏览器和 Electron）
# 留空会使用 /api 和 /ws，由 Vite 转发到本机 http://localhost:8000。
# VITE_API_BASE_URL=
# VITE_WS_BASE_URL=
