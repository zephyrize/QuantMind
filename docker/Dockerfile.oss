# QuantMind OSS Edition - Single Image
# 构建一个镜像运行所有后端服务

FROM python:3.10-slim-bookworm

# 镜像源参数（构建时可传入）
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG APT_MIRROR=mirrors.aliyun.com

# torch 版本选择：cpu（默认，构建快、镜像小）或 gpu（含 CUDA，需 GPU 且构建慢、镜像 ~24GB）
# 用法: docker build --build-arg TORCH_DEVICE=gpu ...
ARG TORCH_DEVICE=cpu
# CPU 版 torch 的国内下载源（阿里云 pytorch-wheels，含 +cpu 轮子）
ARG TORCH_CPU_INDEX_URL=https://download.pytorch.org/whl/cpu
# GPU 版 torch 必须从 CUDA wheel 索引安装，避免通用 PyPI 镜像在下载
# 多 GB NVIDIA 依赖时卡住或回退到 CPU wheel。
ARG TORCH_GPU_INDEX_URL=https://download.pytorch.org/whl/cu128
# rd-agent is an optional factor-evolution component with a very large dependency tree.
# Keep the default image focused on the services started by docker-compose.
ARG INSTALL_RDAGENT=false

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PYTHONPATH=/app \
    SERVICE_MODE=all \
    QUANTMIND_RUNTIME=docker

WORKDIR /app

# 配置 APT 镜像源
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
      sed -i "s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
    else \
      sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
      sed -i "s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      git \
      libgomp1 \
      swig \
      openssh-client \
      rsync \
      sshpass \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY requirements.txt /tmp/requirements.txt
COPY requirements/production.txt /tmp/requirements-production.txt
COPY requirements/ai.txt /tmp/requirements-ai.txt

# 本地 torch wheel 目录（docker/torch_wheels/）被 .gitignore 忽略、不随代码分发。
# CPU 和 GPU 都可复用各自设备类型的本地 wheel 缓存；GPU 构建绝不能
# 安装 +cpu wheel，否则即使 Docker 已透传 NVIDIA GPU，PyTorch 仍无法使用 CUDA。
# 默认按 TORCH_DEVICE 从 PyPI 安装 torch：
#   cpu -> torch==2.9.1+cpu（仅 CPU 轮子，构建快、镜像小，无需 GPU）
#   gpu -> torch==2.9.1（完整 CUDA 轮子，构建慢、镜像大，需 NVIDIA GPU）
# 本地 wheel 存在时优先安装，避免构建环境中下载大文件发生网络超时。
COPY docker/torch_wheels/ /tmp/torch_wheels/
RUN python -m pip install --upgrade pip setuptools wheel cython \
    && if [ "$TORCH_DEVICE" != "gpu" ] && ls /tmp/torch_wheels/*+cpu*.whl >/dev/null 2>&1; then \
         echo "安装本地 CPU torch wheel"; \
         python -m pip install --no-cache-dir --root-user-action=ignore /tmp/torch_wheels/*.whl; \
       elif [ "$TORCH_DEVICE" = "gpu" ] && ls /tmp/torch_wheels/cu128/torch-*+cu128*.whl >/dev/null 2>&1; then \
         echo "离线安装本地 CUDA 12.8 torch wheel 缓存"; \
         python -m pip install --no-cache-dir --root-user-action=ignore --no-index \
           --find-links /tmp/torch_wheels/cu128 "torch==2.9.1+cu128"; \
       elif [ "$TORCH_DEVICE" = "gpu" ]; then \
         echo "构建 GPU 版 torch（完整 CUDA，构建慢）"; \
         python -m pip install --no-cache-dir --root-user-action=ignore "torch==2.9.1" \
           --index-url ${TORCH_GPU_INDEX_URL}; \
       else \
         echo "构建 CPU 版 torch（快速、无需 GPU）"; \
         python -m pip install --no-cache-dir --root-user-action=ignore "torch==2.9.1+cpu" \
           --index-url ${TORCH_CPU_INDEX_URL}; \
       fi \
    && python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements.txt \
    && python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements-production.txt \
    && python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements-ai.txt \
    && rm -rf /tmp/requirements*.txt /tmp/torch_wheels

# 安装 QuantDB SDK（付费高质量数据源：K线/Tick/财报/估值/315维AI因子）
RUN python -m pip install --no-cache-dir --root-user-action=ignore "quantdb-sdk>=0.2.10"

# 修复 qlib 0.9.7 bug: position.py 中 price=None 导致 TypeError
COPY docker/patch_qlib.py /tmp/patch_qlib.py
RUN python /tmp/patch_qlib.py && rm /tmp/patch_qlib.py

# 安装 rd-agent 因子演化模块（可选，目录不存在则跳过）
# rd-agent 在 .gitignore 中，OSS 克隆后可能不存在
COPY docker/install_rdagent.sh /tmp/install_rdagent.sh
# rd-agent 源码（OSS 克隆可能不存在；install 脚本会自行跳过）
COPY rd-agent/ /app/rd-agent/
RUN if [ "$INSTALL_RDAGENT" = "true" ]; then \
      sed -i 's/\r$//' /tmp/install_rdagent.sh \
        && sh /tmp/install_rdagent.sh; \
    else \
      echo "Skipping optional rd-agent installation"; \
    fi \
    && rm -f /tmp/install_rdagent.sh \
    && rm -rf /app/rd-agent

# 复制训练脚本（确保容器内 /app/train.py 存在，避免卷挂载失败时 Docker 创建目录）
COPY docker/training/train.py /app/train.py

# 复制源代码
COPY backend backend
COPY config config
COPY scripts scripts
COPY strategy_templates strategy_templates
# 这些模块由 Engine 的可选路由直接使用；把它们放入镜像，避免 Compose
# 运行时再以宿主机源码卷覆盖镜像内容。
COPY alphaagent alphaagent
COPY TradingAgents-astock TradingAgents-astock
RUN python -m pip install --no-cache-dir --root-user-action=ignore \
      -e /app/TradingAgents-astock "starlette<1.0.0"

# 创建数据目录 & Qlib 符号链接（运行时由 rd_loop_wrapper 按实际缓存路径创建）
RUN mkdir -p /data/models /data/qlib_data /data/uploads /data/strategies /tmp \
    && mkdir -p /root/.qlib/qlib_data
# Qlib features 符号链接在运行时由 entrypoint 或首次访问时创建（数据卷挂载后才存在）

# 暴露端口
EXPOSE 8000 8001 8002 8003

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动所有服务
CMD ["python", "backend/main_oss.py"]
