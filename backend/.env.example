# QuantMind backend application configuration.
# Copy to backend/.env. Infrastructure credentials stay in ../.env.
# DB_HOST, REDIS_HOST, and DATABASE_URL are deliberately omitted:
# host Python resolves 127.0.0.1; Docker Compose resolves db and redis.

APP_EDITION=oss
APP_ENV=development
DEBUG=false

# Browser development origins plus Electron packaged renderer (file:// origin).
# For browser deployments on another origin, add its full origin to this list.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:5173,http://localhost:5173,null
LOG_LEVEL=INFO

# Optional components shown by the Admin Dashboard. Keep these false unless
# the corresponding service is deployed; disabled components are not treated
# as unhealthy. PostgreSQL and Redis always use DB_HOST/REDIS_HOST above.
ADMIN_DASHBOARD_DATA_GATEWAY_ENABLED=false
ADMIN_DASHBOARD_WEB_ENABLED=false
ADMIN_DASHBOARD_QWENPAW_ENABLED=false
ADMIN_DASHBOARD_RSSHUB_ENABLED=false
ADMIN_DASHBOARD_HUNTLY_ENABLED=false
ADMIN_DASHBOARD_DASHBOARD_ENABLED=false
ADMIN_DASHBOARD_CELERY_BEAT_ENABLED=false

# Security — generate unique values before production use.
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_JWT_SECRET
INTERNAL_CALL_SECRET=CHANGE_ME_GENERATE_A_RANDOM_INTERNAL_SECRET
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Service listeners and single-image internal URLs
API_PORT=8000
ENGINE_PORT=8001
TRADE_PORT=8002
STREAM_PORT=8003
WEB_PORT=3080
API_WORKERS=1
ENGINE_WORKERS=1
TRADE_WORKERS=1
STREAM_WORKERS=1
STREAM_ENABLE_OPENTDX_FALLBACK=false
TRADE_SERVICE_URL=http://127.0.0.1:8002
ENGINE_SERVICE_URL=http://127.0.0.1:8001
AI_IDE_SERVICE_URL=http://127.0.0.1:8001
STREAM_SERVICE_URL=http://127.0.0.1:8003
MARKET_DATA_SERVICE_URL=http://127.0.0.1:8003
STRATEGY_SERVICE_URL=http://127.0.0.1:8001
PORTFOLIO_SERVICE_URL=http://127.0.0.1:8002
USER_SERVICE_URL=http://127.0.0.1:8002
REAL_TRADING_SERVICE_URL=http://127.0.0.1:8002

# Storage
STORAGE_MODE=local
STORAGE_ROOT=/data
MARGIN_STOCK_POOL_PATH=/data/融资融券.json
QLIB_BACKTEST_RESULT_DIR=/data/backtest_results
QLIB_BACKTEST_KERNELS=1

# Optional remote source / training configuration
SOURCE_DATABASE_URL=
TRAINING_IMAGE=quantmind-oss:latest
TRAINING_DOCKER_NETWORK=quantmind_quantmind-net
QUANTMIND_API_BASE_URL=http://quantmind:8000
TRAINING_AUTODL_HOST=
TRAINING_AUTODL_SSH_PORT=22
TRAINING_AUTODL_USER=root
TRAINING_AUTODL_SSH_KEY=
TRAINING_AUTODL_SSH_PASSWORD=
TRAINING_AUTODL_WORK_DIR=/workspace
TRAINING_AUTODL_DOCKER_IMAGE=quantmind-train:latest
TRAINING_AUTODL_GPUS=all

# Optional AI providers
DASHSCOPE_API_KEY=
QWEN_API_KEY=
AI_IDE_LLM_API_KEY=
AI_IDE_LLM_BASE_URL=https://api.deepseek.com
AI_IDE_LLM_MODEL=deepseek-chat

# Optional QwenPaw / QuantBot integration
QWENPAW_BASE_URL=http://qwenpaw:8088
COPAW_BASE_URL=http://qwenpaw:8088
QWENPAW_SHARED_FILES_DIR=/qwenpaw-shared
QWENPAW_AUTH_USERNAME=
QWENPAW_AUTH_PASSWORD=

# Optional. Set true to make Engine refuse startup without an LLM key.
AI_STRATEGY_LLM_REQUIRED=false
AI_STRATEGY_TOTAL_MV_PER_YI=100000000.0


# Docker worker and data-platform defaults
SERVICE_MODE=all
DB_DRIVER=asyncpg
BACKTEST_PROGRESS_URL=http://quantmind:8001
TRAINING_PAUSE_OTHERS=true
TRAINING_PROTECTED_NAME_PREFIXES=quantmind,qm-train-,docker-redis-,docker-mysql-,docker-es01-,docker-minio-
HUNTLY_BASE_URL=http://quantmind-huntly
HUNTLY_USERNAME=changeme
HUNTLY_PASSWORD=changeme
NEWS_ENRICH_ENABLED=true
NEWS_ENRICH_INTERVAL_SEC=60
NEWS_MATCHER_RELOAD_SEC=600
DAILY_SYNC_ENABLED=true
QM_QUANTDB_DATA_DIR=/data/quantdb
QUANTDB_STATE_DIR=/data/quantdb/.sync_state
QM_QUANTUS_DATA_DIR=/data/quantus
QM_QUANTHK_DATA_DIR=/data/quanthk
QM_QUANTBC_DATA_DIR=/data/quantbc
QM_QUANTFUTURES_DATA_DIR=/data/quantfutures
QM_TDX_DIR=/data/third_party/tdx
QM_INVESTMENT_DATA_DIR=/data/third_party/investment_data
QM_SIMONLIN_A_DIR=/data/third_party/simonlin_a_stock
ENABLE_CRYPTO=false
CHAT_STREAM=false
MAX_RETRY=30
RETRY_WAIT_SECONDS=5
